# Copie este archivo a .env y complete los valores. .env NO se versiona.
POSTGRES_DB=gestion_deudas
POSTGRES_USER=gd_owner
POSTGRES_PASSWORD=cambie-esta-clave

# Conexión de la API
DB_URL=jdbc:postgresql://localhost:5432/gestion_deudas
DB_USER=gd_owner
DB_PASSWORD=cambie-esta-clave

# Primer administrador (solo se usa si la base no tiene ninguno; mínimo 12 caracteres)
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=cambie-esta-clave-larga
